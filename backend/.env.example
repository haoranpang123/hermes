# 河大家教 环境变量配置
# 复制此文件为 .env 并修改

# App
APP_NAME=河大家教
DEBUG=true
SECRET_KEY=your-secret-key-here

# Database (MySQL)
DATABASE_URL=mysql+aiomysql://root:password@localhost:3306/henu_tutor

# Redis
REDIS_URL=redis://localhost:6379/0

# WeChat Mini Program
WX_APP_ID=your_wx_app_id
WX_APP_SECRET=your_wx_app_secret

# WeChat Pay V3
WXPAY_MCH_ID=your_mch_id
WXPAY_API_V3_KEY=your_api_v3_key
WXPAY_SERIAL_NO=your_serial_no
WXPAY_PRIVATE_KEY_PATH=/path/to/apiclient_key.pem
WXPAY_NOTIFY_URL=https://api.henututor.cn/callback/wxpay

# JWT
JWT_SECRET_KEY=your-jwt-secret-key
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=24

# Tencent Cloud (P1)
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=
TENCENT_IM_SDK_APP_ID=
